# Copy to .env.local and fill in. Never commit .env.local.

# Required — CrustData API key (https://app.crustdata.com/api-keys). API version 2025-11-01 is sent automatically.
CRUSTDATA_API_KEY=

# Optional — Tavily web research for adverse media and press corroboration (https://app.tavily.com).
# Without it, SignalGate falls back to CrustData web search.
TAVILY_API_KEY=

# Optional — LLM "brain" for request parsing, article relevance and memo prose. Decisions are always rule-based.
# LLM_PROVIDER: none | gemini | openrouter. With none (or a failing key) every step falls back to rules.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional — credit rationing (defaults shown)
# CREDIT_BUDGET_PER_RUN=25
# CREDIT_BUDGET_TOTAL=1500
# TAVILY_MAX_CALLS_PER_RUN=3
# LLM_MAX_CALLS_PER_RUN=6
# CACHE_MODE=use            # use | refresh | off  (cache in data/cache, 24h)
